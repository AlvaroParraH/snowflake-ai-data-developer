#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
if command -v python3 >/dev/null 2>&1; then
    exec python3 "$root/scripts/scan_secrets.py"
elif [ -x "$root/.venv/bin/python" ]; then
    exec "$root/.venv/bin/python" "$root/scripts/scan_secrets.py"
else
    printf '%s\n' "Secret scan blocked: Python 3 is required. Install Python and retry." >&2
    exit 1
fi
